# Copy to snowflake/.env (`cp snowflake/env.example snowflake/.env`) (gitignored: *.env never commits) and fill in. Read by the Makefile, the Python loader and dbt.
# Comments must stay on their own lines (make reads this file too).
# SNOWFLAKE_ACCOUNT: <locator>.<region>[.<cloud>] — the cloud segment is required outside AWS us-west-2 (e.g. ab12345.us-east-2.aws;
# without it the connector is routed to a default host and fails with a certificate mismatch), or ORGNAME-ACCOUNTNAME from Snowsight.
SNOWFLAKE_ACCOUNT=ab12345.us-east-2.aws
# SNOWFLAKE_USER: the SERVICE user that owns the key pair (snowflake/README.md step 2)
SNOWFLAKE_USER=LAKEHOUSE_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/lakehouse_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=LAKEHOUSE_ROLE
SNOWFLAKE_WAREHOUSE=LAKEHOUSE_WH
SNOWFLAKE_DATABASE=LAKEHOUSE
# RUNPOD_API_KEY: a read-only Runpod API key (console → Settings → API Keys) for tools/runpod_poll.py; the GitHub workflows use a repository secret
RUNPOD_API_KEY=
